{
  "name": "codex-proxy-rs-web",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "vue-tsc -b --pretty false",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "pnpm run lint:fix",
    "format:check": "pnpm run lint",
    "dev:source": "vite --mode source --host 127.0.0.1",
    "build:source": "vue-tsc -p tsconfig.source.json --noEmit && vite build --mode source"
  },
  "dependencies": {
    "@boxicons/vue": "1.0.1",
    "@codex-proxy/ui": "github:zyycn/codex-proxy-ui#v0.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lucide/vue": "^1.67.0",
    "@vueuse/core": "^15.0.0",
    "@vueuse/integrations": "^15.0.0",
    "axios": "^1.21.0",
    "circle-flags": "2.8.3",
    "css-tree": "^3.2.1",
    "echarts": "^6.1.0",
    "es-toolkit": "^1.53.1",
    "gsap": "^3.15.1",
    "pinia": "^4.1.0",
    "pinia-plugin-persistedstate": "^4.7.1",
    "semver": "^7.8.6",
    "sortablejs": "^1.15.7",
    "vue": "^3.5.44",
    "vue-i18n": "11.4.18",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@intlify/eslint-plugin-vue-i18n": "4.5.1",
    "@intlify/unplugin-vue-i18n": "11.2.8",
    "@tailwindcss/vite": "^4.3.4",
    "@types/css-tree": "^3.2.0",
    "@types/node": "^26.6.6",
    "@types/semver": "^7.8.0",
    "@types/sortablejs": "^1.15.9",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.14.0",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-vuejs-accessibility": "^2.6.3",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vue-tsc": "3.3.14"
  }
}
